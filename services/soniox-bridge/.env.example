# Get this from https://console.soniox.com
SONIOX_API_KEY=

# Shared secret. MUST equal TRANSCRIPTION_SERVICE_TOKEN in Vexa's main stack .env.
# Empty = open (dev only).
API_TOKEN=

# Host port this bridge listens on (Vexa's TRANSCRIPTION_SERVICE_URL should point here).
BRIDGE_PORT=8083

SONIOX_MODEL=stt-rt-v5

# --- Async/batch lane for long windows (fixes long-monologue tail loss) ---
# Windows larger than SONIOX_ASYNC_OVER_BYTES are transcribed via Soniox's async FILE
# API instead of the realtime WS (batch finalizes any length in a few seconds, so it
# never blows past Vexa's 30s abort). Short windows stay realtime for low latency.
#   0            -> everything async
#   very large   -> nothing async (pure realtime — revert to old behavior)
SONIOX_ASYNC_MODEL=stt-async-v5
SONIOX_ASYNC_OVER_BYTES=800000   # ~25s of 16k mono audio
SONIOX_ASYNC_TIMEOUT_S=25        # must stay under Vexa's 30s HTTP abort
SONIOX_ASYNC_POLL_MS=400

# --- Confirmed-transcript latency tuning ---
# The interim "đang nghe" line updates near-instantly; the confirmed transcript
# (top list, feeds translation) only commits a segment once it's considered
# "closed" (sentence punctuation, a pause this long, or a gap this long between
# tokens). Lower = the top list catches up to the interim line faster, at the
# cost of splitting mid-thought more often. Soniox needs ~1-1.5s to commit a
# token as final, so don't go far below that.
STREAM_IDLE_FLUSH_MS=1200
STREAM_SEG_GAP_MS=600

# --- Soniox-native realtime translation (replaces the Claude-based translation
# pipeline in live-translate for whatever langs are set here) ---
# Empty = off (default): live-translate's Claude-based translation is the sole
# path, unchanged behavior. Set to a target language code (e.g. "vi") to have
# Soniox translate every channel directly in the realtime stream — included at
# no extra cost in STT pricing, and near-instant (~tens of ms behind the
# original) vs. an LLM round-trip (measured 8-17s live with Claude).
TRANSLATE_TARGET_LANG=
