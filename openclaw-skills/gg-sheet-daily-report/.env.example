GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
# Same value as the one in openclaw-skills/gg-sheet/.env — this skill is read-only
# and does not need GOOGLE_SERVICE_ACCOUNT_KEY_FILE.
# Same value as GOOGLE_SHEETS_LINK in openclaw-skills/gg-sheet/.env — lets this skill
# trigger gg-sheet's config.json auto-bootstrap (see gg-sheet Bước kiểm tra đầu tiên)
# without an interactive prompt when config.json doesn't exist yet.
GOOGLE_SHEETS_LINK=
