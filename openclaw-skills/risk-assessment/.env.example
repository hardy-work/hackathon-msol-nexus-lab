# Chỉ cần điền phần tương ứng với "source" đang cấu hình trong config.json.
# Skill này self-contained — KHÔNG đọc .env của gg-sheet/jira-task, dù giá trị
# có thể trùng nhau, bạn copy lại vào đây.

# --- source = "gg-sheet" ---
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
# Path to Service Account JSON key file (Editor access trên sheet) — cần cho Action Apply
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# --- source = "jira" ---
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_BASE_URL=https://your-domain.atlassian.net
