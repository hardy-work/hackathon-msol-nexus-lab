# Skill này self-contained — KHÔNG đọc .env của gg-sheet/jira-task-editor, dù
# giá trị có thể trùng nhau, bạn copy lại vào đây.

# Path to Service Account JSON key file (Editor access trên sheet) — dùng cho
# CẢ đọc lẫn ghi (API key đã bỏ hẳn: Google Sheets API key chỉ đọc được sheet
# public "Anyone with the link can view", sheet lịch trình dự án thường để
# private nên API key sẽ luôn trả 403 — xác nhận qua test thật).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# --- source = "jira" (nhánh Jira của v1, chưa thiết kế lại theo layer ở v2) ---
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_BASE_URL=https://your-domain.atlassian.net
