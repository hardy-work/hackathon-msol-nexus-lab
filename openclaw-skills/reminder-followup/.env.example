# Must be quoted — an unquoted leading `#` gets parsed as a comment by the
# gateway's env loader, silently dropping this whole line (the var ends up
# simply absent, not empty, so `openclaw skills check` reports it "missing"
# with no other clue). Root-caused 2026-08-04.
SLACK_REPORT_CHANNEL="#daily-report"
# Raw Slack channel ID (e.g. C0BKLP5KYD7) — required for `openclaw cron create --to channel:<id>`,
# find it via Slack channel details ("About" > Channel ID).
SLACK_REPORT_CHANNEL_ID=
REMINDER_TIME=09:00
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
REMINDER_WEEKDAYS_ONLY=false

# --- Who must report: the "Resource plan" tab of the logtime Google Sheet ---
# The ONLY source of truth. That tab must have `Member` and `Slack ID` columns;
# every row with a valid Slack ID is one person to remind (@-tagged individually).
# The channel member list is never used, and there is no roster file anymore.
# Full share link of the logtime sheet (falls back to GOOGLE_SHEETS_LINK if unset).
LOGTIME_SHEET_LINK=
# Tab name — only set this if your tab is not called "Resource plan".
LOGTIME_SHEET_TAB=Resource plan
# API key with Google Sheets API enabled — read-only is enough. This skill never
# writes: logging a report into the schedule is delegated to the gg-sheet skill
# (Action 4), which owns the Service Account credentials.
GOOGLE_SHEETS_API_KEY=

# Follow-up cron (Việc B): re-checks who hasn't reported and replies in the
# reminder thread tagging whoever is still missing (never DMs, never posts a new
# channel message).
# Dùng GIỜ CỐ ĐỊNH, không dùng `--every`: `--every` neo lại mỗi lần `cron edit`
# nên giờ chạy trôi dần (vd 13:47, 15:47...), và ban đêm vẫn chạy để SKIP vô ích.
# Đúng 2 lượt/ngày, mỗi lượt là MỘT cron job riêng (16:30 và 17:00 không nhét
# được vào 1 expression: `0,30 16,17 * * *` sẽ dính thêm 16:00 và 17:30).
FOLLOWUP_CRON_1=30 16 * * *
FOLLOWUP_CRON_2=0 17 * * *
# Chỉ chặn cron. Yêu cầu tay ("xem ai chưa report") vẫn chạy ngoài giờ này.
FOLLOWUP_CUTOFF_TIME=17:30
