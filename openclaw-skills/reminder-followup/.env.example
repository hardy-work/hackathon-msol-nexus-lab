SLACK_REPORT_CHANNEL=#daily-report
# Raw Slack channel ID (e.g. C0BKLP5KYD7) — required for `openclaw cron create --to channel:<id>`,
# find it via Slack channel details ("About" > Channel ID).
SLACK_REPORT_CHANNEL_ID=
REMINDER_TIME=09:00
REMINDER_TIMEZONE=Asia/Ho_Chi_Minh
REMINDER_WEEKDAYS_ONLY=false

# Who must report is defined per channel in roster/<SLACK_REPORT_CHANNEL_ID>.json
# (see roster/README.md) — not from the channel member list, and not from here.

# Follow-up cron (Việc B): re-checks who hasn't reported and replies in the
# reminder thread tagging whoever is still missing (never DMs, never posts a new
# channel message).
# Dùng GIỜ CỐ ĐỊNH, không dùng `--every`: `--every` neo lại mỗi lần `cron edit`
# nên giờ chạy trôi dần (vd 13:47, 15:47...), và ban đêm vẫn chạy để SKIP vô ích.
# Đúng 2 lượt/ngày, mỗi lượt là MỘT cron job riêng (16:30 và 17:00 không nhét
# được vào 1 expression: `0,30 16,17 * * *` sẽ dính thêm 16:00 và 17:30).
FOLLOWUP_CRON_1=30 16 * * *
FOLLOWUP_CRON_2=0 17 * * *
# Chỉ chặn cron. Yêu cầu tay ("xem ai chưa report") vẫn chạy ngoài giờ này.
FOLLOWUP_CUTOFF_TIME=17:30
