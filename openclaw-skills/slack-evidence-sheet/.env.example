# Slack — bot token, cần scope: channels:history, groups:history, files:read, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Google OAuth — file client JSON tải từ GCP Console (Credentials > OAuth client ID > Desktop app)
GOOGLE_OAUTH_CLIENT_FILE=./oauth-client.json

# Refresh token lấy 1 lần bằng: node scripts/oauth-setup.js (gitignored, đừng commit)
GOOGLE_OAUTH_TOKEN_FILE=./oauth-token.json
