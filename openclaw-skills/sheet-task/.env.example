# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.

# URL Web App sau khi Deploy Apps Script (dạng https://script.google.com/macros/s/.../exec)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Token sinh ra bằng hàm setupToken() trong Code.gs
SHEET_API_TOKEN=your_token_here
