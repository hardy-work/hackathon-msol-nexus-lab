SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
PROJECT_KNOWLEDGE_SLACK_ROLE_MAP={"U012345":["project_member"]}

# Mount this directory on a persistent volume in production.
PROJECT_KNOWLEDGE_STATE_DIR=/var/lib/project-knowledge
SLACK_EMBEDDED_WORKER=1
SLACK_JOB_MAX_ATTEMPTS=5
SLACK_JOB_RETRY_BASE_SECONDS=2
SLACK_JOB_RETENTION_DAYS=30

PROJECT_KNOWLEDGE_CACHE_TTL_SECONDS=86400
PROJECT_KNOWLEDGE_CACHE_MAX_ROWS=10000
PROJECT_KNOWLEDGE_CONVERSATION_TTL_DAYS=30
PROJECT_KNOWLEDGE_CONVERSATION_MAX_PER_THREAD=100
PROJECT_KNOWLEDGE_VERSION_CHECK_SECONDS=5
