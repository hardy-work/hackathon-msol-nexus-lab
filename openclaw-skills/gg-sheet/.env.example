GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
# Path to Service Account JSON key file (needs Editor access on the sheet) — required for write actions (add/edit/delete)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Full share link of this project's schedule Google Sheet — one .env per project/machine,
# so the skill auto-configures config.json from this on first use instead of asking for the link.
# Leave empty to fall back to asking interactively.
GOOGLE_SHEETS_LINK=
