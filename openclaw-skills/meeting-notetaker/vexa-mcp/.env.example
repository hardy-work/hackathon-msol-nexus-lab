VEXA_BASE_URL=http://192.168.4.15:18056
VEXA_API_KEY=<YOUR_VEXA_API_KEY>

# Live-translate integration (optional). When WEB_PUBLIC_URL is set, join_meeting
# returns a `share_link` to the realtime transcript+translation room, which the
# meeting-notetaker skill posts into the Slack thread. Must point at the running
# live-translate web app (see ../live-translate).
WEB_PUBLIC_URL=
# Fixed translation target for the shared link (viewers can't change it).
LIVE_TRANSLATE_LANG=vi
