# Used for join_meeting/bot_status/stop_meeting/list_meetings (bot
# orchestration only — Vexa is no longer a transcript source, see below).
VEXA_BASE_URL=http://192.168.4.15:18056
VEXA_API_KEY=<YOUR_VEXA_API_KEY>

# Live-translate integration — REQUIRED for get_transcript (see below); also
# what makes join_meeting return a `share_link` to the realtime
# transcript+translation room, which the meeting-notetaker skill posts into
# the Slack thread. Must point at the running live-translate web app (see
# ../live-translate).
WEB_PUBLIC_URL=
# Fixed translation target for the shared link (viewers can't change it).
LIVE_TRANSLATE_LANG=vi
# get_transcript's ONLY transcript source (live-translate's assembled
# transcript, sourced from the B-full Soniox stream) — Vexa's own
# /transcripts endpoint is never called. Defaults to WEB_PUBLIC_URL; only set
# this separately if live-translate's internal URL differs from the public one.
LIVE_TRANSLATE_BASE_URL=
