# Get this from https://console.soniox.com
SONIOX_API_KEY=

# Shared secret. MUST equal TRANSCRIPTION_SERVICE_TOKEN in Vexa's main stack .env.
# Empty = open (dev only).
API_TOKEN=

# Host port this bridge listens on (Vexa's TRANSCRIPTION_SERVICE_URL should point here).
BRIDGE_PORT=8083

SONIOX_MODEL=stt-rt-v5

# --- Async/batch lane for long windows (fixes long-monologue tail loss) ---
# Windows larger than SONIOX_ASYNC_OVER_BYTES are transcribed via Soniox's async FILE
# API instead of the realtime WS (batch finalizes any length in a few seconds, so it
# never blows past Vexa's 30s abort). Short windows stay realtime for low latency.
#   0            -> everything async
#   very large   -> nothing async (pure realtime — revert to old behavior)
SONIOX_ASYNC_MODEL=stt-async-v5
SONIOX_ASYNC_OVER_BYTES=800000   # ~25s of 16k mono audio
SONIOX_ASYNC_TIMEOUT_S=25        # must stay under Vexa's 30s HTTP abort
SONIOX_ASYNC_POLL_MS=400
