# --- Vexa (same instance as vexa-mcp) ---
VEXA_BASE_URL=http://localhost:18056
VEXA_API_KEY=

# --- Web ---
PORT=8080
# Public base URL used to build the shareable /meet/... link (Slack, etc.)
WEB_PUBLIC_URL=http://localhost:8080
DEFAULT_TARGET_LANG=vi

# --- Realtime tuning ---
POLL_INTERVAL_S=1.5
IDLE_SHUTDOWN_S=300

# --- Translation backend ---
# "subscription" (default) -> warm, persistent `claude` session via the Agent
#   SDK. Uses your Claude Pro/Max login (no per-token bill). ~2-3s per
#   translation once the session is up. Requires Claude Code installed & logged
#   in, and ANTHROPIC_API_KEY unset for this process.
# "cli" -> spawns a fresh `claude -p` per call (~6s each). Simpler, no SDK.
# "api" -> Anthropic Messages API (~1-2s, needs ANTHROPIC_API_KEY, per-token).
TRANSLATE_BACKEND=subscription
TRANSLATE_MODEL=claude-haiku-4-5
# TRANSLATE_RECYCLE_AFTER=40   # reconnect the warm session every N translations
# CLAUDE_BIN=claude            # for TRANSLATE_BACKEND=cli
# TRANSLATE_TIMEOUT_S=45       # for TRANSLATE_BACKEND=cli
# ANTHROPIC_API_KEY=           # only for TRANSLATE_BACKEND=api
